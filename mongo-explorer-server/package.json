{
    "name": "mongo-explorer-server",
    "version": "0.1.0",
    "description": "Mongo Explorer server — brokers all MongoDB access, hosts the MCP server.",
    "private": true,
    "main": "dist/index.js",
    "scripts": {
        "start": "ts-node src/index.ts",
        "dev": "ts-node src/index.ts",
        "build": "tsc",
        "serve:dist": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "check:actor-gate": "ts-node scripts/check-actor-gate.ts",
        "test": "node --test --experimental-strip-types \"test/**/*.test.ts\""
    },
    "dependencies": {
        "@azure/identity": "^4.5.0",
        "@modelcontextprotocol/sdk": "^1.12.0",
        "bcryptjs": "^2.4.3",
        "body-parser": "^2.2.0",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "inversify": "^6.2.2",
        "jsonwebtoken": "^9.0.2",
        "mongodb": "^6.12.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "socket.io": "^4.8.1",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/body-parser": "^1.19.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.10.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.2"
    }
}
